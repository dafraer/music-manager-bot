# Required: token from @BotFather, channel username/ID, and your Telegram user ID.
BOT_TOKEN=
CHANNEL_ID=
ALLOWED_USER_IDS=

# MP3 bitrate in kbps: 64, 96, 128, 160, 192, 256, or 320.
AUDIO_BITRATE=320
MAX_DURATION_SECONDS=1200
MAX_CONCURRENT_DOWNLOADS=1
DOWNLOAD_TIMEOUT_SECONDS=600
UPLOAD_TIMEOUT_SECONDS=300
# Decimal MB. Keep uploads below Telegram's 50 MB limit.
MAX_UPLOAD_MB=49
MAX_DOWNLOAD_MB=100
LOG_LEVEL=INFO
